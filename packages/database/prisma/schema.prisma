// -----------------------------------------------------------------------------
// Public end-user accounts (accounts-service, /public-auth).
// Fully independent of the internship applicant portal and admin auth: own
// tables, own session cookie (growblic_user_session), own throttling.
// -----------------------------------------------------------------------------

model PublicUserAccount {
  id                  String                         @id @default(cuid())
  emailNormalized     String                         @unique @map("email_normalized")
  emailDisplay        String                         @map("email_display")
  passwordHash        String                         @map("password_hash")
  displayName         String?                        @map("display_name")
  fullName            String?                        @map("full_name")
  phone               String?                        @map("phone")
  company             String?                        @map("company")
  status              PublicUserAccountStatus         @default(ACTIVE)
  failedLoginCount    Int                            @default(0) @map("failed_login_count")
  lastLoginAt         DateTime?                      @map("last_login_at")
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")
  deletedAt           DateTime?                      @map("deleted_at")
  sessions            PublicUserSession[]
  passwordResetTokens PublicUserPasswordResetToken[]

  @@index([status])
  @@index([createdAt])
  @@map("public_user_accounts")
}

model PublicUserSession {
  id         String            @id @default(cuid())
  accountId  String            @map("account_id")
  tokenHash  String            @unique @map("token_hash")
  expiresAt  DateTime          @map("expires_at")
  lastSeenAt DateTime?         @map("last_seen_at")
  revokedAt  DateTime?         @map("revoked_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  ipAddress  String?           @map("ip_address")
  userAgent  String?           @map("user_agent")
  account    PublicUserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([createdAt])
  @@map("public_user_sessions")
}

model PublicUserPasswordResetToken {
  id        String            @id @default(cuid())
  accountId String            @map("account_id")
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at")
  usedAt    DateTime?         @map("used_at")
  createdAt DateTime          @default(now()) @map("created_at")
  ipAddress String?           @map("ip_address")
  userAgent String?           @map("user_agent")
  account   PublicUserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("public_user_password_reset_tokens")
}

model PublicUserAuthAttempt {
  id            String   @id @default(cuid())
  emailHash     String   @map("email_hash")
  ipAddressHash String?  @map("ip_address_hash")
  action        String
  successful    Boolean
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([emailHash, action, createdAt])
  @@index([ipAddressHash, action, createdAt])
  @@map("public_user_auth_attempts")
}

enum PublicUserAccountStatus {
  ACTIVE
  DISABLED
}
