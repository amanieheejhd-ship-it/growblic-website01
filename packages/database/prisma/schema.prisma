generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model ContactEnquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  budget    String?
  message   String
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_enquiries")
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String?         @map("password_hash")
  status       AdminUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?       @map("last_login_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")
  sessions     AdminSession[]
  roles        AdminUserRole[]
  auditLogs    AuditLog[]
  uploads      MediaAsset[]    @relation("MediaAssetUploader")

  @@index([status, deletedAt])
  @@index([createdAt])
  @@map("admin_users")
}

model AdminRole {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  users       AdminUserRole[]

  @@index([createdAt])
  @@map("admin_roles")
}

model AdminUserRole {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  adminRoleId String    @map("admin_role_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  adminRole   AdminRole @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, adminRoleId])
  @@index([adminRoleId])
  @@map("admin_user_roles")
}

model Service {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  shortDescription String?       @map("short_description")
  description      String?
  status           ContentStatus @default(DRAFT)
  displayOrder     Int           @default(0) @map("display_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  @@index([status, deletedAt])
  @@index([displayOrder])
  @@index([createdAt])
  @@map("services")
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String?       @map("short_description")
  description      String?
  websiteUrl       String?       @map("website_url")
  playStoreUrl     String?       @map("play_store_url")
  appStoreUrl      String?       @map("app_store_url")
  logoMediaId      String?       @map("logo_media_id")
  status           ContentStatus @default(DRAFT)
  displayOrder     Int           @default(0) @map("display_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  logoMedia        MediaAsset?   @relation("ProductLogo", fields: [logoMediaId], references: [id])

  @@index([logoMediaId])
  @@index([status, deletedAt])
  @@index([displayOrder])
  @@index([createdAt])
  @@map("products")
}

model PortfolioProject {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  summary      String?
  description  String?
  clientName   String?       @map("client_name")
  projectUrl   String?       @map("project_url")
  coverMediaId String?       @map("cover_media_id")
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  coverMedia   MediaAsset?   @relation("PortfolioCover", fields: [coverMediaId], references: [id])

  @@index([coverMediaId])
  @@index([status, deletedAt])
  @@index([displayOrder])
  @@index([publishedAt])
  @@index([createdAt])
  @@map("portfolio_projects")
}

model Testimonial {
  id            String        @id @default(cuid())
  personName    String        @map("person_name")
  companyName   String?       @map("company_name")
  designation   String?
  quote         String
  rating        Int?
  avatarMediaId String?       @map("avatar_media_id")
  status        ContentStatus @default(DRAFT)
  displayOrder  Int           @default(0) @map("display_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")
  avatarMedia   MediaAsset?   @relation("TestimonialAvatar", fields: [avatarMediaId], references: [id])

  @@index([avatarMediaId])
  @@index([status, deletedAt])
  @@index([displayOrder])
  @@index([createdAt])
  @@map("testimonials")
}

model JobOpening {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  department     String?
  location       String?
  employmentType EmploymentType   @map("employment_type")
  experience     String?
  description    String
  status         JobOpeningStatus @default(DRAFT)
  publishedAt    DateTime?        @map("published_at")
  closesAt       DateTime?        @map("closes_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  applications   JobApplication[]

  @@index([status, deletedAt])
  @@index([publishedAt])
  @@index([closesAt])
  @@index([createdAt])
  @@map("job_openings")
}

model JobApplication {
  id            String               @id @default(cuid())
  jobOpeningId  String               @map("job_opening_id")
  candidateName String               @map("candidate_name")
  email         String
  phone         String?
  experience    String?
  resumeMediaId String?              @map("resume_media_id")
  coverLetter   String?              @map("cover_letter")
  status        JobApplicationStatus @default(NEW)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  jobOpening    JobOpening           @relation(fields: [jobOpeningId], references: [id])
  resumeMedia   MediaAsset?          @relation("JobApplicationResume", fields: [resumeMediaId], references: [id])

  @@index([jobOpeningId])
  @@index([resumeMediaId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("job_applications")
}

model CareerApplication {
  id            String               @id @default(cuid())
  submissionKey String               @unique @map("submission_key")
  candidateName String               @map("candidate_name")
  email         String
  phone         String
  role          String
  experience    String
  workLinks     String[]             @map("work_links")
  message       String
  status        JobApplicationStatus @default(NEW)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("career_applications")
}

model InternshipApplication {
  id                      String                        @id @default(cuid())
  submissionKey           String                        @unique @map("submission_key")
  internshipSlug          String                        @map("internship_slug")
  candidateName           String                        @map("candidate_name")
  email                   String
  phone                   String
  state                   String
  instituteEnrollment     String                        @map("institute_enrollment")
  instituteName           String?                       @map("institute_name")
  course                  String?
  enrollmentNumber        String?                       @map("enrollment_number")
  highestQualification    String?                       @map("highest_qualification")
  passingYear             String?                       @map("passing_year")
  message                 String?
  status                  JobApplicationStatus          @default(NEW)
  selectedPlanId          String?                       @map("selected_plan_id")
  selectedPlanName        String?                       @map("selected_plan_name")
  selectedPlanDuration    Int?                          @map("selected_plan_duration")
  selectedPlanAmountPaise Int?                          @map("selected_plan_amount_paise")
  selectedPlanCurrency    String?                       @map("selected_plan_currency")
  planSelectedAt          DateTime?                     @map("plan_selected_at")
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")
  applicantAccountId      String?                       @map("applicant_account_id")
  applicantAccount        InternshipApplicantAccount?   @relation(fields: [applicantAccountId], references: [id], onDelete: SetNull)
  authFlows               InternshipApplicantAuthFlow[]
  certificate             InternshipCertificate?
  payment                 InternshipPayment?

  @@index([applicantAccountId])
  @@index([email])
  @@index([internshipSlug])
  @@index([selectedPlanDuration])
  @@index([status])
  @@index([createdAt])
  @@map("internship_applications")
}

model InternshipPayment {
  id                      String                  @id @default(cuid())
  internshipApplicationId String                  @unique @map("internship_application_id")
  accessTokenHash         String                  @map("access_token_hash")
  gateway                 String                  @default("RAZORPAY")
  gatewayOrderId          String                  @unique @map("gateway_order_id")
  gatewayPaymentId        String?                 @unique @map("gateway_payment_id")
  selectedDuration        Int                     @map("selected_duration")
  internshipProgram       String                  @map("internship_program")
  amountPaise             Int                     @map("amount_paise")
  currency                String                  @default("INR")
  status                  InternshipPaymentStatus @default(CREATED)
  customerName            String                  @map("customer_name")
  customerEmail           String                  @map("customer_email")
  customerPhone           String                  @map("customer_phone")
  paymentMethod           String?                 @map("payment_method")
  paidAt                  DateTime?               @map("paid_at")
  internshipStartedAt     DateTime?               @map("internship_started_at")
  expectedCompletionAt    DateTime?               @map("expected_completion_at")
  completedAt             DateTime?               @map("completed_at")
  offerLetterGeneratedAt  DateTime?               @map("offer_letter_generated_at")
  certificateAvailableAt  DateTime?               @map("certificate_available_at")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  confirmationReference   String?                 @unique @map("confirmation_reference")
  confirmationSequence    Int?                    @map("confirmation_sequence")
  confirmationYear        Int?                    @map("confirmation_year")
  joiningDate             DateTime?               @map("joining_date")
  confirmationIssuedAt    DateTime?               @map("confirmation_issued_at")
  certificate             InternshipCertificate?
  internshipApplication   InternshipApplication   @relation(fields: [internshipApplicationId], references: [id])
  invoice                 Invoice?

  @@unique([confirmationYear, confirmationSequence])
  @@index([internshipApplicationId, status])
  @@index([customerEmail])
  @@index([status, createdAt])
  @@index([confirmationIssuedAt])
  @@map("internship_payments")
}

model InternshipApplicantAccount {
  id                      String                                      @id @default(cuid())
  emailNormalized         String                                      @unique @map("email_normalized")
  emailDisplay            String                                      @map("email_display")
  passwordHash            String?                                     @map("password_hash")
  status                  InternshipApplicantAccountStatus            @default(ACTIVE)
  emailVerifiedAt         DateTime?                                   @map("email_verified_at")
  failedLoginCount        Int                                         @default(0) @map("failed_login_count")
  lastLoginAt             DateTime?                                   @map("last_login_at")
  createdAt               DateTime                                    @default(now()) @map("created_at")
  updatedAt               DateTime                                    @updatedAt @map("updated_at")
  applications            InternshipApplication[]
  passwordResetTokens     InternshipApplicantPasswordResetToken[]
  emailVerificationTokens InternshipApplicantEmailVerificationToken[]
  sessions                InternshipApplicantSession[]
  oauthIdentities         InternshipApplicantOAuthIdentity[]
  documentAccesses        InternshipApplicantDocumentAccess[]

  @@index([status])
  @@index([createdAt])
  @@map("internship_applicant_accounts")
}

model InternshipApplicantDocumentAccess {
  id           String                               @id @default(cuid())
  accountId    String                               @map("account_id")
  documentType InternshipApplicantDocumentType      @map("document_type")
  documentId   String                               @map("document_id")
  actorType    InternshipApplicantDocumentActorType @map("actor_type")
  action       InternshipApplicantDocumentAction    @map("action")
  createdAt    DateTime                             @default(now()) @map("created_at")
  account      InternshipApplicantAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, documentType, actorType, action, createdAt], map: "internship_applicant_document_access_account_doc_actor_action")
  @@index([documentType, documentId])
  @@index([createdAt])
  @@map("internship_applicant_document_accesses")
}

model InternshipApplicantOAuthIdentity {
  id                    String                     @id @default(cuid())
  accountId             String                     @map("account_id")
  provider              String
  providerSubject       String                     @map("provider_subject")
  providerEmail         String?                    @map("provider_email")
  providerEmailVerified Boolean                    @default(false) @map("provider_email_verified")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  account               InternshipApplicantAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([accountId])
  @@index([providerEmail])
  @@map("internship_applicant_oauth_identities")
}

model InternshipApplicantAuthFlow {
  id                      String                @id @default(cuid())
  tokenHash               String                @unique @map("token_hash")
  applicationId           String                @map("application_id")
  selectedPlanId          String                @map("selected_plan_id")
  selectedPlanName        String                @map("selected_plan_name")
  selectedPlanDuration    Int                   @map("selected_plan_duration")
  selectedPlanAmountPaise Int                   @map("selected_plan_amount_paise")
  selectedPlanCurrency    String                @default("INR") @map("selected_plan_currency")
  provider                String?
  oauthStateHash          String?               @unique @map("oauth_state_hash")
  oauthCodeVerifier       String?               @map("oauth_code_verifier")
  expiresAt               DateTime              @map("expires_at")
  consumedAt              DateTime?             @map("consumed_at")
  createdAt               DateTime              @default(now()) @map("created_at")
  ipAddress               String?               @map("ip_address")
  userAgent               String?               @map("user_agent")
  application             InternshipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([provider])
  @@map("internship_applicant_auth_flows")
}

model InternshipApplicantSession {
  id         String                     @id @default(cuid())
  accountId  String                     @map("account_id")
  tokenHash  String                     @unique @map("token_hash")
  expiresAt  DateTime                   @map("expires_at")
  lastSeenAt DateTime?                  @map("last_seen_at")
  revokedAt  DateTime?                  @map("revoked_at")
  createdAt  DateTime                   @default(now()) @map("created_at")
  ipAddress  String?                    @map("ip_address")
  userAgent  String?                    @map("user_agent")
  account    InternshipApplicantAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([createdAt])
  @@map("internship_applicant_sessions")
}

model InternshipApplicantAuthAttempt {
  id            String   @id @default(cuid())
  emailHash     String   @map("email_hash")
  ipAddressHash String?  @map("ip_address_hash")
  action        String
  successful    Boolean
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([emailHash, action, successful, createdAt])
  @@index([ipAddressHash, action, successful, createdAt])
  @@index([createdAt])
  @@map("internship_applicant_auth_attempts")
}

model InternshipApplicantPasswordResetToken {
  id        String                     @id @default(cuid())
  accountId String                     @map("account_id")
  tokenHash String                     @unique @map("token_hash")
  expiresAt DateTime                   @map("expires_at")
  usedAt    DateTime?                  @map("used_at")
  createdAt DateTime                   @default(now()) @map("created_at")
  ipAddress String?                    @map("ip_address")
  userAgent String?                    @map("user_agent")
  account   InternshipApplicantAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdAt])
  @@map("internship_applicant_password_reset_tokens")
}

model InternshipApplicantEmailVerificationToken {
  id        String                     @id @default(cuid())
  accountId String                     @map("account_id")
  tokenHash String                     @unique @map("token_hash")
  expiresAt DateTime                   @map("expires_at")
  usedAt    DateTime?                  @map("used_at")
  createdAt DateTime                   @default(now()) @map("created_at")
  ipAddress String?                    @map("ip_address")
  userAgent String?                    @map("user_agent")
  account   InternshipApplicantAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdAt])
  @@map("internship_applicant_email_verification_tokens")
}

model InternshipCertificate {
  id                   String                              @id @default(cuid())
  applicationId        String                              @unique @map("application_id")
  paymentId            String                              @unique @map("payment_id")
  durationDays         Int                                 @map("duration_days")
  paidAt               DateTime                            @map("paid_at")
  joiningDate          DateTime?                           @map("joining_date")
  completionDate       DateTime?                           @map("completion_date")
  reminderDueAt        DateTime?                           @map("reminder_due_at")
  status               InternshipCertificateStatus         @default(PENDING_START_DATE)
  domainRole           String?                             @map("domain_role")
  designation          String?                             @map("designation")
  projectWork          String?                             @map("project_work")
  performanceSummary   String?                             @map("performance_summary")
  conductNote          String?                             @map("conduct_note")
  remarks              String?
  certificateNumber    String?                             @unique @map("certificate_number")
  certificateSequence  Int?                                @map("certificate_sequence")
  certificateYear      Int?                                @map("certificate_year")
  issuedAt             DateTime?                           @map("issued_at")
  generatedAt          DateTime?                           @map("generated_at")
  pdfBytes             Bytes?                              @map("pdf_bytes")
  pdfSha256            String?                             @map("pdf_sha256")
  reminderStatus       InternshipCertificateReminderStatus @default(PENDING) @map("reminder_status")
  reminderAttemptCount Int                                 @default(0) @map("reminder_attempt_count")
  reminderSentAt       DateTime?                           @map("reminder_sent_at")
  reminderLastError    String?                             @map("reminder_last_error")
  reminderClaimToken   String?                             @map("reminder_claim_token")
  reminderClaimedAt    DateTime?                           @map("reminder_claimed_at")
  emailStatus          InternshipCertificateEmailStatus    @default(PENDING) @map("email_status")
  emailAttemptCount    Int                                 @default(0) @map("email_attempt_count")
  emailedAt            DateTime?                           @map("emailed_at")
  emailLastError       String?                             @map("email_last_error")
  emailClaimToken      String?                             @map("email_claim_token")
  emailClaimedAt       DateTime?                           @map("email_claimed_at")
  nextEmailAttemptAt   DateTime?                           @map("next_email_attempt_at")
  blockedAlertSentAt   DateTime?                           @map("blocked_alert_sent_at")
  createdAt            DateTime                            @default(now()) @map("created_at")
  updatedAt            DateTime                            @default(now()) @updatedAt @map("updated_at")
  publicReference      String                              @unique @map("public_reference")
  emailAttempts        InternshipCertificateEmailAttempt[]
  skills               InternshipCertificateSkill[]
  application          InternshipApplication               @relation(fields: [applicationId], references: [id])
  payment              InternshipPayment                   @relation(fields: [paymentId], references: [id])

  @@unique([certificateYear, certificateSequence])
  @@index([status])
  @@index([completionDate])
  @@index([reminderDueAt])
  @@index([emailedAt])
  @@index([reminderStatus, reminderDueAt])
  @@index([emailStatus, completionDate, nextEmailAttemptAt], map: "internship_certificates_email_status_completion_date_next_email")
  @@map("internship_certificates")
}

model InternshipCertificateSkill {
  id            String                @id @default(cuid())
  certificateId String                @map("certificate_id")
  position      Int
  name          String
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at")
  certificate   InternshipCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@unique([certificateId, position])
  @@index([certificateId])
  @@map("internship_certificate_skills")
}

model InternshipCertificateEmailAttempt {
  id             String                         @id @default(cuid())
  certificateId  String                         @map("certificate_id")
  kind           InternshipCertificateEmailKind
  idempotencyKey String                         @unique @map("idempotency_key")
  recipient      String
  successful     Boolean
  providerId     String?                        @map("provider_id")
  safeError      String?                        @map("safe_error")
  attemptedAt    DateTime                       @default(now()) @map("attempted_at")
  certificate    InternshipCertificate          @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId, kind, attemptedAt], map: "internship_certificate_email_attempts_certificate_id_kind_attem")
  @@index([successful, attemptedAt], map: "internship_certificate_email_attempts_successful_attempted_at_i")
  @@map("internship_certificate_email_attempts")
}

model InternshipCertificateSequence {
  year      Int      @id
  lastValue Int      @map("last_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("internship_certificate_sequences")
}

model InternshipConfirmationSequence {
  year      Int      @id
  lastValue Int      @map("last_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("internship_confirmation_sequences")
}

model Invoice {
  id             String                @id @default(cuid())
  paymentId      String                @unique @map("payment_id")
  invoiceNumber  String                @unique @map("invoice_number")
  issuedAt       DateTime              @map("issued_at")
  customerName   String                @map("customer_name")
  customerEmail  String                @map("customer_email")
  customerPhone  String                @map("customer_phone")
  description    String
  amountPaise    Int                   @map("amount_paise")
  totalPaise     Int                   @map("total_paise")
  currency       String                @default("INR")
  deliveryStatus InvoiceDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryError  String?               @map("delivery_error")
  deliveredAt    DateTime?             @map("delivered_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  payment        InternshipPayment     @relation(fields: [paymentId], references: [id])

  @@index([issuedAt])
  @@index([deliveryStatus])
  @@map("invoices")
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([createdAt])
  @@map("payment_webhook_events")
}

model MeetingRequest {
  id            String        @id @default(cuid())
  submissionKey String        @unique @map("submission_key")
  name          String
  email         String?
  phone         String?
  message       String
  source        String?
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("meeting_requests")
}

model QuoteRequest {
  id             String        @id @default(cuid())
  submissionKey  String        @unique @map("submission_key")
  name           String
  email          String?
  phone          String?
  company        String?
  location       String?
  service        String?
  budget         String?
  requirements   String
  calculatorData Json?         @map("calculator_data")
  source         String?
  status         EnquiryStatus @default(NEW)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("quote_requests")
}

model SiteSetting {
  id          String           @id @default(cuid())
  key         String           @unique
  value       String
  valueType   SettingValueType @default(STRING) @map("value_type")
  description String?
  isPublic    Boolean          @default(false) @map("is_public")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([isPublic])
  @@index([createdAt])
  @@map("site_settings")
}

model MediaAsset {
  id                    String             @id @default(cuid())
  filename              String
  originalName          String             @map("original_name")
  mimeType              String             @map("mime_type")
  sizeBytes             BigInt             @map("size_bytes")
  storageProvider       String             @map("storage_provider")
  storagePath           String             @map("storage_path")
  publicUrl             String?            @map("public_url")
  altText               String?            @map("alt_text")
  uploadedByAdminUserId String?            @map("uploaded_by_admin_user_id")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  deletedAt             DateTime?          @map("deleted_at")
  jobApplicationResumes JobApplication[]   @relation("JobApplicationResume")
  uploadedByAdminUser   AdminUser?         @relation("MediaAssetUploader", fields: [uploadedByAdminUserId], references: [id])
  portfolioCovers       PortfolioProject[] @relation("PortfolioCover")
  productLogos          Product[]          @relation("ProductLogo")
  testimonialAvatars    Testimonial[]      @relation("TestimonialAvatar")

  @@unique([storageProvider, storagePath])
  @@index([uploadedByAdminUserId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("media_assets")
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?    @map("admin_user_id")
  action      String
  entityType  String     @map("entity_type")
  entityId    String?    @map("entity_id")
  metadata    Json?
  ipAddress   String?    @map("ip_address")
  userAgent   String?    @map("user_agent")
  createdAt   DateTime   @default(now()) @map("created_at")
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  lastSeenAt  DateTime? @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([createdAt])
  @@map("admin_sessions")
}

model AdminLoginAttempt {
  id            String   @id @default(cuid())
  emailHash     String   @map("email_hash")
  ipAddressHash String?  @map("ip_address_hash")
  successful    Boolean
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([emailHash, successful, createdAt])
  @@index([ipAddressHash, successful, createdAt])
  @@index([createdAt])
  @@map("admin_login_attempts")
}

