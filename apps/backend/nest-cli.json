{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "webpack": true,
    "webpackConfigPath": "webpack.config.cjs",
    "assets": [
      {
        "include": "assets/fonts/*.ttf",
        "watchAssets": true
      }
    ]
  }
}
