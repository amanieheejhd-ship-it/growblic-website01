    "@nestjs/platform-express": "11.1.28",
    "@pdf-lib/fontkit": "^1.1.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pdf-lib": "^1.17.1",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@growblic/eslint-config": "workspace:*",
    "@growblic/typescript-config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "@types/supertest": "7.2.0",
    "eslint": "9.39.4",
    "supertest": "7.2.2",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3"
  }
}
