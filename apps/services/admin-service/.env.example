# Local development defaults are shown here. Production must set every value explicitly.
NODE_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4002
PORT=4002
LOG_LEVEL=info

# Comma-separated exact production origins. Localhost HTTP origins are allowed only outside production.
CORS_ALLOWED_ORIGINS=https://amanieheejhd-ship-it.github.io,https://growblic.com

# Request limits are bytes and milliseconds.
REQUEST_BODY_LIMIT=65536
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_READINESS_TIMEOUT_MS=2000

# Enable only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false

# Supplied by the runtime secret store. Never commit a real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# HMAC pepper for admin login throttling identifiers. Required by the admin module.
ADMIN_AUTH_PEPPER=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Certificate preview / offer-letter PDFs are proxied to the internship-service
# internal endpoints. The token must match the internship-service value.
INTERNSHIP_SERVICE_INTERNAL_URL=http://localhost:4000
INTERNSHIP_CERTIFICATE_INTERNAL_TOKEN=

# Admin-triggered certificate reminder tests (non-production only).
INTERNSHIP_CERTIFICATE_TEST_MODE=false
INTERNSHIP_CERTIFICATE_TEST_REMINDER_MINUTES=5
INTERNSHIP_CERTIFICATE_REMINDER_DAYS=5
