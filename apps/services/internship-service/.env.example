# Local development defaults are shown here. Production must set every value explicitly.
NODE_ENV=development
BACKEND_HOST=127.0.0.1
# Port 4000 is load-bearing: the Razorpay webhook URL, portal cookie flows and
# the frontend NEXT_PUBLIC_API_URL all point at it.
BACKEND_PORT=4000
PORT=4000
LOG_LEVEL=info

# Comma-separated exact production origins. Localhost HTTP origins are allowed only outside production.
CORS_ALLOWED_ORIGINS=https://amanieheejhd-ship-it.github.io,https://growblic.com

# Request limits are bytes and milliseconds.
REQUEST_BODY_LIMIT=65536
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_READINESS_TIMEOUT_MS=2000

# Enable only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false

# Supplied by the runtime secret store. Never commit a real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Razorpay test-mode credentials. Store real values only in the deployment secret store.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Temporary non-production-only demo payment. Never enable in production.
INTERNSHIP_DEMO_PAYMENT_ENABLED=false
ENABLE_DEMO_PAYMENT=false

# Resend invoice delivery.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=
INVOICE_ADMIN_EMAIL=

# Confirmation/offer-letter email delivery provider configuration.
INTERNSHIP_CERTIFICATE_EMAIL_PROVIDER=resend
INTERNSHIP_CERTIFICATE_FROM_EMAIL=
INTERNSHIP_CERTIFICATE_REMINDER_DAYS=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=

# Token guarding /internal/internship-certificates/* (consumed by admin-service).
INTERNSHIP_CERTIFICATE_INTERNAL_TOKEN=

# SSO bridge (public accounts-service → internship portal). Shared secret sent to
# accounts-service's /internal/public-user-identity to resolve the public
# session owner. MUST match accounts-service's PUBLIC_IDENTITY_INTERNAL_TOKEN.
# Unset ⇒ the bridge is disabled and the portal shows its normal login.
PUBLIC_IDENTITY_INTERNAL_TOKEN=
# Base URL for internal calls to accounts-service (SSO bridge). No trailing slash.
ACCOUNTS_SERVICE_INTERNAL_URL=http://localhost:4004

# Internship portal OAuth and URLs.
APPLICANT_AUTH_PEPPER=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_AUTH_PEPPER=REPLACE_WITH_A_LONG_RANDOM_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
FRONTEND_URL=http://localhost:3002
PUBLIC_WEBSITE_URL=http://localhost:3002
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
