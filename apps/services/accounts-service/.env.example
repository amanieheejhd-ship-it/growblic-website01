# Local development defaults are shown here. Production must set every value explicitly.
NODE_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4004
PORT=4004
LOG_LEVEL=info

# Comma-separated exact production origins. Localhost HTTP origins are allowed only outside production.
CORS_ALLOWED_ORIGINS=https://amanieheejhd-ship-it.github.io,https://growblic.com

# Request limits are bytes and milliseconds.
REQUEST_BODY_LIMIT=65536
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_READINESS_TIMEOUT_MS=2000

# Enable only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false

# Supplied by the runtime secret store. Never commit a real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Peppers the SHA-256/HMAC throttle identifiers (email + ip). REQUIRED in production.
PUBLIC_AUTH_PEPPER=change-me-in-production

# Password-reset email (Resend). If unset, forgot-password still returns the
# generic success message and logs the reset link server-side (dev only).
RESEND_API_KEY=
PUBLIC_AUTH_FROM_EMAIL=Growblic <no-reply@growblic.com>

# Base URL used to build password-reset links (points at the public website).
FRONTEND_URL=http://localhost:3002
PUBLIC_WEBSITE_URL=http://localhost:3002

# Shared secret guarding the internal SSO bridge. internship-service presents it
# on GET /internal/public-user-identity to resolve the owner of a public session.
# MUST match internship-service's PUBLIC_IDENTITY_INTERNAL_TOKEN. Unset ⇒ 503
# (bridge disabled). Blocked at the public gateway (/internal/* → 403).
PUBLIC_IDENTITY_INTERNAL_TOKEN=
