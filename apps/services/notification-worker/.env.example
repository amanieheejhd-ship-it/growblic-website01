# Local development defaults are shown here. Production must set every value explicitly.
NODE_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4003
PORT=4003
LOG_LEVEL=info

# Request limits are bytes and milliseconds.
REQUEST_BODY_LIMIT=65536
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_READINESS_TIMEOUT_MS=2000

# Enable only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false

# Supplied by the runtime secret store. Never commit a real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Certificate jobs are the worker's purpose: they run by default and only
# INTERNSHIP_CERTIFICATE_JOBS_ENABLED=false disables them.
INTERNSHIP_CERTIFICATE_JOBS_ENABLED=true
INTERNSHIP_CERTIFICATE_TEST_MODE=false
INTERNSHIP_CERTIFICATE_TEST_REMINDER_MINUTES=5
INTERNSHIP_CERTIFICATE_JOB_INTERVAL_SECONDS=30
INTERNSHIP_CERTIFICATE_ADMIN_EMAIL=rajputgautam356@gmail.com
INTERNSHIP_CERTIFICATE_REMINDER_DAYS=5
INTERNSHIP_CERTIFICATE_ADMIN_BASE_URL=http://localhost:3001

# Email delivery (resend or smtp).
INTERNSHIP_CERTIFICATE_EMAIL_PROVIDER=resend
INTERNSHIP_CERTIFICATE_FROM_EMAIL=
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
