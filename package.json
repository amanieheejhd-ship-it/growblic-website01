{
  "name": "growblic-website01",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "nx run-many -t dev --parallel=10",
    "dev:web": "pnpm --filter @growblic/web dev",
    "dev:admin": "pnpm --filter @growblic/admin dev",
    "dev:services": "nx run-many -t dev --parallel=10 -p @growblic/submissions-service @growblic/accounts-service @growblic/admin-service @growblic/internship-service @growblic/notification-worker",
    "dev:internship": "pnpm --filter @growblic/internship-service dev",
    "dev:submissions": "pnpm --filter @growblic/submissions-service dev",
    "dev:accounts": "pnpm --filter @growblic/accounts-service dev",
    "dev:admin-service": "pnpm --filter @growblic/admin-service dev",
    "dev:worker": "pnpm --filter @growblic/notification-worker dev",
    "build": "nx run-many -t build",
    "build:web": "pnpm --filter @growblic/web build",
    "build:admin": "pnpm --filter @growblic/admin build",
    "build:services": "nx run-many -t build -p @growblic/submissions-service @growblic/accounts-service @growblic/admin-service @growblic/internship-service @growblic/notification-worker",
    "build:pages": "node scripts/build-github-pages.mjs",
    "start": "pnpm --filter @growblic/web start",
    "start:web": "pnpm --filter @growblic/web start",
    "start:admin": "pnpm --filter @growblic/admin start",
    "lint": "nx run-many -t lint",
    "lint:web": "pnpm --filter @growblic/web lint",
    "lint:admin": "pnpm --filter @growblic/admin lint",
    "lint:services": "nx run-many -t lint -p @growblic/submissions-service @growblic/accounts-service @growblic/admin-service @growblic/internship-service @growblic/notification-worker",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "affected": "nx affected -t build,lint,typecheck,test",
    "graph": "nx graph",
    "typecheck:web": "pnpm --filter @growblic/web typecheck",
    "typecheck:admin": "pnpm --filter @growblic/admin typecheck",
    "typecheck:services": "nx run-many -t typecheck -p @growblic/submissions-service @growblic/accounts-service @growblic/admin-service @growblic/internship-service @growblic/notification-worker",
    "test:services": "nx run-many -t test -p @growblic/submissions-service @growblic/accounts-service @growblic/admin-service @growblic/internship-service @growblic/notification-worker",
    "test:website-submissions": "tsx --test apps/web/src/lib/api.test.ts && pnpm --filter @growblic/submissions-service test",
    "postinstall": "pnpm --filter @growblic/database prisma:generate",
    "prisma": "pnpm --filter @growblic/database exec prisma",
    "prisma:format": "pnpm --filter @growblic/database prisma:format",
    "prisma:validate": "pnpm --filter @growblic/database prisma:validate",
    "prisma:generate": "pnpm --filter @growblic/database prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @growblic/database prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter @growblic/database prisma:migrate:deploy",
    "prisma:studio": "pnpm --filter @growblic/database prisma:studio",
    "db:verify-cms": "tsx --tsconfig apps/web/tsconfig.json scripts/verify-cms-schema.ts",
    "admin:bootstrap": "tsx --tsconfig apps/services/admin-service/tsconfig.json scripts/bootstrap-admin.ts",
    "admin:bootstrap:apply": "tsx --tsconfig apps/services/admin-service/tsconfig.json scripts/bootstrap-admin.ts --apply",
    "admin:sessions:cleanup": "tsx --tsconfig apps/web/tsconfig.json scripts/cleanup-admin-sessions.ts",
    "admin:sessions:cleanup:apply": "tsx --tsconfig apps/web/tsconfig.json scripts/cleanup-admin-sessions.ts --apply",
    "auth:verify": "tsx --tsconfig apps/services/admin-service/tsconfig.json scripts/verify-admin-auth.ts",
    "auth:test-api": "node scripts/test-admin-auth-api.mjs",
    "auth:verify-db": "tsx --tsconfig apps/services/admin-service/tsconfig.json scripts/verify-admin-auth-db.ts",
    "admin:test-pages": "node scripts/test-admin-pages.mjs",
    "admin:submissions:test-api": "node scripts/test-admin-submissions-api.mjs",
    "admin:submissions:verify-db": "tsx --tsconfig apps/admin/tsconfig.json scripts/verify-admin-submissions-db.ts",
    "forms:test-api": "node scripts/test-website-form-apis.mjs",
    "forms:verify-db": "tsx --tsconfig apps/web/tsconfig.json scripts/verify-website-form-db.ts",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "workspace:check": "node scripts/check-workspace-foundation.mjs"
  },
  "dependencies": {
    "@growblic/database": "workspace:*",
    "argon2": "^0.44.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-globe.gl": "^2.38.0",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "^23.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "nx": "^23.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
