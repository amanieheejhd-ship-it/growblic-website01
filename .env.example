DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

ADMIN_AUTH_PEPPER="REPLACE_WITH_A_LONG_RANDOM_SECRET"
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_NAME="Example Administrator"
ADMIN_BOOTSTRAP_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD_AT_LEAST_12_CHARACTERS"

NEXT_PUBLIC_API_URL=https://growblic-api.onrender.com

NEXT_PUBLIC_GROWBLIC_API_URL=https://growblic-api.onrender.com

# Public, non-secret Supabase Edge Function URL used by the GitHub Pages build.
NEXT_PUBLIC_WEBSITE_SUBMISSIONS_URL=https://PROJECT_REF.supabase.co/functions/v1/website-submissions

# Configure these only as Supabase Edge Function secrets. Never prefix either with NEXT_PUBLIC_.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SUPABASE_SECRETS_ONLY
