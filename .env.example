DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Consumed by the admin-service (apps/services/admin-service) admin module for login throttling HMACs.
ADMIN_AUTH_PEPPER="REPLACE_WITH_A_LONG_RANDOM_SECRET"
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_NAME="Example Administrator"
ADMIN_BOOTSTRAP_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD_AT_LEAST_12_CHARACTERS"

# Consumed by the accounts-service (apps/services/accounts-service) public-user
# login module. Peppers the throttle-identifier HMACs — REQUIRED in production.
PUBLIC_AUTH_PEPPER="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Password-reset email via Resend. If either is unset, forgot-password still
# returns the generic success and logs the reset link server-side (dev) — the
# flow is never blocked by email configuration.
PUBLIC_AUTH_FROM_EMAIL=
# Shared Resend API key (also used by internship-service / notification-worker).
RESEND_API_KEY=

# Primary API origin (internship-service: portal, payments, chat).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Origin serving /public-submissions/* (submissions-service). Falls back to
# NEXT_PUBLIC_API_URL when unset, so a single-origin gateway deployment works.
NEXT_PUBLIC_SUBMISSIONS_API_URL=http://localhost:4001
# Origin serving /public-auth/* (accounts-service: public user login, register,
# password reset, profile). Falls back to NEXT_PUBLIC_API_URL when unset, so a
# single-origin gateway deployment works.
NEXT_PUBLIC_ACCOUNTS_API_URL=http://localhost:4004
NEXT_PUBLIC_ENABLE_INTERNSHIP_DEMO_PAYMENT=false
NEXT_PUBLIC_ENABLE_DEMO_PAYMENT=false

NEXT_PUBLIC_GROWBLIC_API_URL=http://localhost:4000

INTERNSHIP_CERTIFICATE_JOBS_ENABLED=false
INTERNSHIP_CERTIFICATE_TEST_MODE=false
INTERNSHIP_CERTIFICATE_TEST_REMINDER_MINUTES=5
INTERNSHIP_CERTIFICATE_JOB_INTERVAL_SECONDS=30
INTERNSHIP_CERTIFICATE_ADMIN_EMAIL=rajputgautam356@gmail.com
INTERNSHIP_CERTIFICATE_REMINDER_DAYS=5
INTERNSHIP_CERTIFICATE_EMAIL_PROVIDER=resend
INTERNSHIP_CERTIFICATE_FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
INTERNSHIP_CERTIFICATE_ADMIN_BASE_URL=https://admin.example.com
INTERNSHIP_CERTIFICATE_INTERNAL_TOKEN="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Internal URL the admin app (apps/admin) uses to reach the admin-service API.
# Defaults to http://localhost:4002 when unset.
BACKEND_INTERNAL_URL=https://api.example.com

# Internal URL the admin-service uses to proxy certificate PDFs from the
# internship-service. Defaults to http://localhost:4000 when unset.
INTERNSHIP_SERVICE_INTERNAL_URL=http://localhost:4000
