# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/apps/web/node_modules/
/apps/admin/node_modules/
/apps/services/*/node_modules/
/packages/database/node_modules/
/packages/*/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# package build output
/packages/*/dist/

# next.js
/.next/
/out/
/apps/web/.next/
/apps/web/out/
/apps/admin/.next/
/apps/admin/out/
/apps/services/*/dist/
/apps/services/*/.test-dist/
.turbo/

# production
/build

# misc
.DS_Store
*.pem
*.bak
*.backup-*
package-lock.json

# nx
.nx/cache
.nx/workspace-data

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm-cache/
.pnpm-store/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/packages/database/src/generated/prisma
